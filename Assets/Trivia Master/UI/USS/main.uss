/* ==========================================================================
   main.uss
   Structural layout + component styles. Colors always come from theme.uss
   custom properties (var(--...)) so this file never hard-codes a color and
   the light/dark toggle "just works" everywhere.
   ========================================================================== */

/* ---------------------------------------------------------------------- */
/* Root / screens                                                          */
/* ---------------------------------------------------------------------- */

.theme-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.screen-slot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding: 36px 24px 28px 24px;
    display: flex;
}

.screen--hidden {
    display: none;
}

/* ---------------------------------------------------------------------- */
/* Typography                                                              */
/* ---------------------------------------------------------------------- */

.title {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--color-primary);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: normal;
}

.title-accent {
    width: 64px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--cat-history);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xl);
}

.title--compact {
    font-size: 26px;
    margin-bottom: var(--space-lg);
}

.subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
    white-space: normal;
}

/* ---------------------------------------------------------------------- */
/* Buttons — one consistent size, a chunky "pressable card" shape with a   */
/* thick colored bottom edge for depth (instead of the old flat pill).    */
/* ---------------------------------------------------------------------- */

.btn {
    height: var(--button-height);
    min-height: var(--button-height);
    max-height: var(--button-height);
    width: 100%;
    max-width: 340px;
    border-radius: var(--button-radius);
    background-color: var(--color-surface);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--button-edge);
    border-bottom-color: var(--color-border-strong);
    margin-bottom: var(--space-md);
    font-size: var(--button-font-size);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    transition-property: translate, border-bottom-width, background-color;
    transition-duration: 0.06s;
}

.btn:hover {
    background-color: var(--color-surface-alt);
}

.btn:active {
    translate: 0 var(--button-edge);
    border-bottom-width: 0;
}

.btn--primary {
    background-color: var(--color-primary);
    border-bottom-color: var(--color-primary-shadow);
    color: var(--color-on-primary);
}

.btn--primary:hover {
    background-color: var(--color-primary-hover);
}

.btn--primary:active {
    background-color: var(--color-primary-pressed);
}

.btn--compact {
    height: var(--button-height-compact);
    min-height: var(--button-height-compact);
    max-height: var(--button-height-compact);
    max-width: 220px;
}

/* Safety valve for longer button labels (e.g. "SELECT NEW CATEGORY") so
   text wraps/shrinks to fit the pill instead of spilling past its edges. */
.btn--tight {
    font-size: 16px;
    white-space: normal;
    padding: 4px 10px;
}

.btn--danger {
    background-color: var(--color-danger);
    border-bottom-color: var(--color-danger-shadow);
    color: var(--color-on-primary);
}

.btn--last {
    margin-bottom: 0;
}

/* ---------------------------------------------------------------------- */
/* Main menu                                                               */
/* ---------------------------------------------------------------------- */

.menu-spacer {
    flex-grow: 1;
}

.menu-buttons {
    width: 100%;
    align-items: center;
    flex-direction: column;
}

/* ---------------------------------------------------------------------- */
/* Settings screen                                                         */
/* ---------------------------------------------------------------------- */

.settings-list {
    width: 100%;
    max-width: 340px;
    align-items: stretch;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: var(--color-border);
    height: 64px;
    padding: 0 20px;
    margin-bottom: var(--space-md);
}

.settings-row__label {
    font-size: 17px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

/* Switch-style toggle (instead of Unity's default checkbox look).
   Structure Unity generates for every <ui:Toggle>:
     .unity-toggle > .unity-toggle__input > .unity-toggle__checkmark
   We turn __input into the pill "track" and __checkmark into the round
   "knob", then slide the knob across via translate on the :checked state. */
.unity-toggle {
    margin: 0;
    min-width: 0;
    flex-shrink: 0;
}

.unity-toggle .unity-toggle__input {
    width: 46px;
    height: 26px;
    border-radius: var(--radius-pill);
    background-color: var(--color-border-strong);
    border-width: 0;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.unity-toggle:checked .unity-toggle__input {
    background-color: var(--color-primary);
}

.unity-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    margin: 3px;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.15s;
}

.unity-toggle:checked .unity-toggle__checkmark {
    translate: 20px 0;
}

/* ---------------------------------------------------------------------- */
/* Category select — every button gets its own bold color identity        */
/* ---------------------------------------------------------------------- */

.category-spacer {
    height: 28px;
}

.category-list {
    width: 100%;
    align-items: center;
    flex-direction: column;
}

.cat-btn {
    color: var(--color-on-primary);
    -unity-text-align: middle-left;
    padding-left: 26px;
}

.cat-btn--movies {
    background-color: var(--cat-movies);
    border-bottom-color: var(--cat-movies-shadow);
}

.cat-btn--history {
    background-color: var(--cat-history);
    border-bottom-color: var(--cat-history-shadow);
}

.cat-btn--sports {
    background-color: var(--cat-sports);
    border-bottom-color: var(--cat-sports-shadow);
}

.cat-btn--science {
    background-color: var(--cat-science);
    border-bottom-color: var(--cat-science-shadow);
}

.cat-btn--random {
    background-color: var(--cat-random);
    border-bottom-color: var(--cat-random-shadow);
}

/* ---------------------------------------------------------------------- */
/* Gameplay HUD + question card                                            */
/* ---------------------------------------------------------------------- */

.hud-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
}

.hud-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface);
    border-radius: var(--radius-pill);
    border-width: 2px;
    border-color: var(--color-border-strong);
    padding: 6px 14px;
}

.hearts-row {
    flex-direction: row;
}

.heart {
    font-size: 18px;
    color: var(--color-danger);
    margin-right: 2px;
}

.heart--lost {
    color: var(--color-border-strong);
}

.hud-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
}

.hud-text--timer {
    color: var(--cat-history-shadow);
}

.hud-text--score {
    color: var(--color-primary);
}

.question-card {
    width: 100%;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    border-width: 2px;
    border-color: var(--color-border);
    padding: 0 20px 24px 20px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xl);
    min-height: 140px;
    overflow: hidden;
}

.question-card__accent {
    width: 100%;
    height: 8px;
    background-color: var(--color-primary);
    margin: -2px -20px 20px -20px;
}

.question-counter {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
    -unity-font-style: bold;
}

.question-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
}

.gameplay-spacer {
    flex-grow: 1;
}

.answer-grid {
    width: 100%;
    flex-direction: column;
}

.answer-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
}

.answer-btn {
    width: 48%;
    max-width: 48%;
    height: var(--button-height);
    min-height: var(--button-height);
    max-height: var(--button-height);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: var(--color-border-strong);
    margin-bottom: var(--space-md);
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: translate, border-bottom-width, background-color;
    transition-duration: 0.06s;
}

.answer-btn:hover {
    background-color: var(--color-surface-alt);
}

.answer-btn:active {
    translate: 0 4px;
    border-bottom-width: 0;
}

.answer-btn--correct {
    background-color: var(--color-success);
    border-bottom-color: var(--color-success-shadow);
    color: var(--color-on-primary);
}

.answer-btn--wrong {
    background-color: var(--color-danger);
    border-bottom-color: var(--color-danger-shadow);
    color: var(--color-on-primary);
}

/* ---------------------------------------------------------------------- */
/* Modal-style result panels (Game Over / Category Complete)               */
/* ---------------------------------------------------------------------- */

.modal-backdrop {
    background-color: var(--color-overlay);
    align-items: center;
    justify-content: center;
    padding: 28px;
}

.modal-card {
    width: 100%;
    max-width: 340px;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 0 28px 28px 28px;
    align-items: center;
    overflow: hidden;
}

.modal-accent {
    width: 100%;
    height: 10px;
    margin: 0 -28px 28px -28px;
}

.modal-accent--danger {
    background-color: var(--color-danger);
}

.modal-accent--success {
    background-color: var(--color-success);
}

.modal-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-sm);
}

.modal-title--danger {
    color: var(--color-danger-strong);
}

.modal-title--success {
    color: var(--color-success-strong);
}

.modal-score {
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--color-primary);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-xl);
}

.modal-buttons {
    width: 100%;
    align-items: center;
}

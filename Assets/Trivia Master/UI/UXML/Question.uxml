<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ui:VisualElement name="QuestionPanel" class="screen screen--hidden">
        <ui:VisualElement class="hud-row">
            <ui:VisualElement class="hud-chip">
                <ui:VisualElement name="HeartsRow" class="hearts-row">
                    <ui:Label text="&#9829;" name="Heart0" class="heart" />
                    <ui:Label text="&#9829;" name="Heart1" class="heart" />
                    <ui:Label text="&#9829;" name="Heart2" class="heart" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-chip">
                <ui:Label name="TimerText" text="00:00" class="hud-text hud-text--timer" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-chip">
                <ui:Label name="ScoreText" text="Score: 0/10" class="hud-text hud-text--score" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="question-card">
            <ui:VisualElement class="question-card__accent" />
            <ui:Label name="QuestionCounterText" text="1/10" class="question-counter" />
            <ui:Label name="QuestionText" text="Question text goes here" class="question-text" />
        </ui:VisualElement>
        <ui:VisualElement class="gameplay-spacer" />
        <ui:VisualElement class="answer-grid">
            <ui:VisualElement class="answer-row">
                <ui:Button name="AnswerButton0" text="Answer 1" class="answer-btn" />
                <ui:Button name="AnswerButton1" text="Answer 2" class="answer-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="answer-row">
                <ui:Button name="AnswerButton2" text="Answer 3" class="answer-btn" />
                <ui:Button name="AnswerButton3" text="Answer 4" class="answer-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

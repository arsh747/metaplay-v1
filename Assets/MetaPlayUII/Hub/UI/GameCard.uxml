<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="card-root" class="game-card">
        <ui:VisualElement name="card-icon" class="card-icon" />
        <ui:VisualElement class="card-header-scrim" />
        <ui:VisualElement class="card-header">
            <ui:Label name="card-title" text="Game name" class="card-title" />
            <ui:VisualElement name="card-underline" class="card-underline" />
        </ui:VisualElement>
        <ui:VisualElement name="card-lock" class="card-lock">
            <ui:Label text="Locked" class="lock-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

.theme-dark {
    --color-bg: #0d0d0f;
    --color-surface: #1c1c20;
    --color-text-primary: #f2f2f2;
    --color-text-secondary: #7a7a80;
    --color-divider: #232327;
}

.theme-light {
    --color-bg: #f4f1ec;
    --color-surface: #e9e4d8;
    --color-text-primary: #2b2a28;
    --color-text-secondary: #8a857c;
    --color-divider: #ddd7c9;
}

.app-root {
    flex-grow: 1;
    background-color: var(--color-bg);
}

.screen-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

.spacer {
    flex-grow: 1;
}

.icon-button {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    border-width: 0;
    font-size: 22px;
    -unity-text-align: middle-center;
}
